# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-...pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-...pooler.supabase.com:5432/postgres"

JWT_SECRET=
PORT=3001
FRONTEND_URL=http://localhost:3000

# Supabase — from Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Comma-separated emails that get promoted to ADMIN role on sync
ADMIN_EMAILS=

# Stripe — test mode secret key from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# SMTP — used to email customers when their order status changes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudinary — used to store saved 3D design previews
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
